pipeline {
    agent any

    environment {
        PYTHON = 'python3'
        PIP = 'pip3'
    }

    stages {
        stage('Environment & Checkout') {
            steps {
                echo "========== CI/CD PIPELINE INITIALIZATION =========="
                sh 'git log -n 1 --oneline'
                sh 'python3 --version'
            }
        }

        stage('Install Pipeline Dependencies') {
            steps {
                echo "========== INSTALLING PIPELINE DEPENDENCIES =========="
                sh '''
                    python3 -m pip install --break-system-packages -q fastapi uvicorn pydantic httpx pytest requests scikit-learn pandas numpy || true
                '''
            }
        }

        stage('DVC Data Verification') {
            steps {
                echo "========== DVC DATASET INTEGRITY CHECK =========="
                sh '''
                    test -f final_project/data/iris_dataset.csv.dvc
                    cat final_project/data/iris_dataset.csv.dvc
                    if [ ! -f final_project/data/iris_dataset.csv ]; then
                        python3 final_project/data/generate_dataset.py
                    fi
                    test -s final_project/data/iris_dataset.csv
                    echo "DVC tracked dataset verified successfully."
                '''
            }
        }

        stage('Data Quality Tests') {
            steps {
                echo "========== EXECUTING DATA QUALITY TESTS =========="
                sh '''
                    python3 -m pytest -v -o cache_dir=/tmp/.pytest_cache final_project/tests/test_data_quality.py
                '''
            }
        }

        stage('API Unit & Integration Tests') {
            steps {
                echo "========== EXECUTING UNIT & INTEGRATION TESTS =========="
                sh '''
                    python3 -m pytest -v -o cache_dir=/tmp/.pytest_cache final_project/tests/test_api.py
                '''
            }
        }

        stage('Docker Image Build & Smoke Test') {
            steps {
                echo "========== BUILDING PRODUCTION DOCKER IMAGE =========="
                sh '''
                    # 1. Build production Docker image inside pipeline
                    docker build -t final-mlops-app:latest final_project/

                    # 2. Inspect and verify built image
                    docker image inspect final-mlops-app:latest --format 'Image ID: {{.Id}} | Size: {{.Size}} bytes | Architecture: {{.Architecture}}'

                    # 3. Lightweight live container smoke test
                    CONTAINER_NAME="pipeline-smoke-${BUILD_NUMBER}"
                    echo "Starting smoke test container: ${CONTAINER_NAME}"
                    
                    # Detect network of Jenkins controller so smoke test container can be reached
                    JENKINS_NET=$(docker inspect jenkins-mlops -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}' 2>/dev/null || echo "")
                    
                    if [ -n "$JENKINS_NET" ]; then
                        docker run -d --rm --name "${CONTAINER_NAME}" --network "${JENKINS_NET}" final-mlops-app:latest
                        sleep 3
                        echo "Testing /health endpoint via container network..."
                        curl -s -f "http://${CONTAINER_NAME}:8000/health" || exit 1
                        echo ""
                        echo "Testing /predict endpoint via container network..."
                        curl -s -f -X POST "http://${CONTAINER_NAME}:8000/predict" \
                            -H "Content-Type: application/json" \
                            -d '{"sepal_length": 5.1, "sepal_width": 3.5, "petal_length": 1.4, "petal_width": 0.2}' || exit 1
                        echo ""
                    else
                        docker run -d --rm --name "${CONTAINER_NAME}" final-mlops-app:latest
                        sleep 3
                    fi

                    # Stop smoke test container
                    docker stop "${CONTAINER_NAME}" > /dev/null 2>&1 || true
                    echo "Docker image build, inspection, and smoke test completed successfully."
                '''
            }
        }
    }

    post {
        success {
            echo "=========================================================="
            echo "CI/CD PIPELINE SUCCEEDED: ALL QUALITY & UNIT GATES PASSED!"
            echo "=========================================================="
        }
        failure {
            echo "=========================================================="
            echo "CI/CD PIPELINE FAILED: INSPECT LOGS FOR FAILED GATES."
            echo "=========================================================="
        }
    }
}
